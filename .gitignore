# --- secrets ---------------------------------------------------------------
.env
.env.local
.env.*
!.env.example
*.pem
*.key

# --- backups (full DB dumps + blobstore archives — NEVER publish these) ---
backups/

# --- runtime state ---------------------------------------------------------
blobstore/
workspace/
evaluation_results/
# Lite-mode sqlite database (created by `bucker lite` / start.bat at repo root)
bucker_lite.db
bucker_lite.db-wal
bucker_lite.db-shm
*.lite.db
# Local memory + skills (user-owned data at repo root, git-ignored by design)
# NOTE: root-anchored — bucker/memory/ is source code and must be tracked.
/memory/
/skills/
*.log

# Recorded model responses. Deliberately NOT committed by default: they are
# derived data keyed by request hash, they grow without bound during iteration,
# and they only make sense paired with the blobs in blobstore/ (also ignored) —
# committing one without the other leaves dangling refs.
#
# Benchmark recordings that back a *published* result are a different thing:
# those get exported deliberately to a versioned artifact, not swept in by
# accident. See BUILD_PLAN step 30.
recordings/

# --- vendored binaries -----------------------------------------------------
# temporal.exe is ~141 MB. GitHub hard-rejects files over 100 MB, and even a
# compressed blob bloats every future clone forever. Install the Temporal CLI
# on PATH (scoop install temporal) instead of keeping it in the repo.
temporal.exe
temporal
*.exe
*.dll

# --- python ----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- editors / os ----------------------------------------------------------
.idea/
.vscode/
.DS_Store
Thumbs.db
