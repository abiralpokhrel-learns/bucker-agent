{
  "name": "bucker-agent-desktop",
  "version": "2.0.0",
  "description": "Desktop Agentic IDE for Bucker-Agent",
  "author": "Bucker contributors",
  "license": "Apache-2.0",
  "main": "dist/main/index.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.json",
    "start": "electron .",
    "dev": "tsc -p tsconfig.json -w",
    "package:win": "node packaging/sync-gateway.cjs && npm --prefix ../bucker/frontend run build && npm run build:main && electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "org.bucker.desktop",
    "productName": "Bucker Desktop",
    "directories": {"output": "release"},
    "files": ["dist/**/*", "package.json"],
    "extraResources": [
      {"from": "build/runtime", "to": "runtime", "filter": ["**/*", "!**/__pycache__/**", "!**/*.pyc", "!**/.env", "!**/.env.*"]},
      {"from": "../bucker/frontend/dist", "to": "renderer"}
    ],
    "win": {"target": ["nsis"], "signAndEditExecutable": false},
    "nsis": {"oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "runAfterFinish": false, "createDesktopShortcut": true},
    "artifactName": "Bucker-Desktop-${version}-Setup.${ext}"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.13.4",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.3"
  }
}
