# Copy to .env and adjust. Never commit .env.

# --- storage ---------------------------------------------------------------
# The app connects as bucker_app, which has INSERT+SELECT on events and nothing
# else. That is deliberate: the application literally cannot rewrite history.
BUCKER_DATABASE_URL=postgresql://bucker_app:dev@localhost:5432/bucker
BUCKER_BLOB_ROOT=./blobstore

# Superuser DSN, used only by `bucker migrate` (DDL needs owner rights).
BUCKER_ADMIN_DATABASE_URL=postgresql://postgres:dev@localhost:5432/bucker

# Set this to run the database test suite (unset = those tests skip).
BUCKER_TEST_DATABASE_URL=postgresql://postgres:dev@localhost:5432/bucker

# --- temporal --------------------------------------------------------------
BUCKER_TEMPORAL_HOST=localhost:7233
BUCKER_TEMPORAL_NAMESPACE=default
BUCKER_TASK_QUEUE=bucker-tasks

# --- model router (Phase 1, step 14) ---------------------------------------
# The model name lives HERE and nowhere else in the codebase. Swapping models
# next year must be an env change, not a refactor. This file IS loaded at
# startup (bucker/config.py), and a real environment variable always wins over
# a value set here.
#
# OpenRouter — note the required "openrouter/" prefix; without it LiteLLM sends
# the request to the wrong provider and you get a confusing 401:
#   BUCKER_MODEL=openrouter/anthropic/claude-sonnet-4
#   BUCKER_MODEL=openrouter/openai/gpt-4o
#   BUCKER_MODEL=openrouter/google/gemini-2.5-pro
# Direct providers use the bare name:
#   BUCKER_MODEL=gpt-4o-mini
#
# Recommended starting point: a FREE model. No credit required, no download, and
# far stronger than a small local model. Free tier allows 20 req/min and 50
# req/day (1000/day once the account has ever held $10).
BUCKER_MODEL=openrouter/nvidia/nemotron-3-super-120b-a12b:free

# Offline/rate-limit option: a local Ollama model runs through LiteLLM without
# an API key, but Docker is still required for the sandbox. Choose and download
# a coding model appropriate to your hardware, then use:
#   ollama pull <model>
#   BUCKER_MODEL=ollama/<model>

# Fallback chain: comma-separated models tried in order when the primary fails
# (provider down, key rejected, quota exhausted). A dead provider must not
# take down a task. Replay stays keyed to the PRIMARY model, so determinism
# is unaffected.
# BUCKER_MODEL_FALLBACKS=ollama/qwen2.5-coder:3b,openrouter/nvidia/nemotron-3-super-120b-a12b:free

# When you do add credit, prefer cheap-but-strong for iteration. Note that M2
# compares this platform against a single-agent baseline on the SAME model, so
# the model is the controlled variable — and a top-tier model can actively hurt
# the experiment by leaving no headroom for the architecture to show a
# difference (ceiling effect). Aim for ~50-70% solve rate on your task set.
#BUCKER_MODEL=openrouter/minimax/minimax-m3        # cheap, ~80% SWE-bench
#BUCKER_MODEL=openrouter/anthropic/claude-sonnet-4 # frontier tier

# recorded = replay stored responses (free, deterministic, the default)
# live     = call the provider
BUCKER_MODEL_MODE=recorded

# Tight enough for a small smoke run, but 3000 leaves room for a complete
# unified diff and its JSON wrapper. A 1200-token worker response can truncate
# mid-object and surface as a misleading schema failure.
# BUCKER_MAX_TOKENS_PLANNER=1000
# BUCKER_MAX_TOKENS_WORKER=3000

# Exactly one provider key. NEVER commit this file (.gitignore covers it), and
# never paste a key into a chat, an issue, or a commit message — treat any key
# that has left your machine as burned and rotate it.
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- guardrails (Phase 2, step 32) -----------------------------------------
BUCKER_DEFAULT_BUDGET_USD=0.75
BUCKER_DEFAULT_DEADLINE_MINUTES=15
BUCKER_MAX_RETRIES=2

# --- api -------------------------------------------------------------------
BUCKER_API_TOKEN=dev-token
